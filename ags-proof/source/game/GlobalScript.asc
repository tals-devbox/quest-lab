// Quest Lab original test adventure. No Sierra assets or behavior-parity claim.
bool typedMode;
bool herbTaken;
bool questDone;
int talkStage;
int clockTicks;
int writes;
int saveSerial;
Overlay* caption;
String message;

function Report() {
  File* f=File.Open("$APPDATADIR$/proof-state.json",eFileWrite);
  if(f!=null) {
    f.WriteRawLine(String.Format("{\"room\":%d,\"x\":%d,\"y\":%d,\"herb\":%d,\"quest\":%d,\"talk\":%d,\"typed\":%d,\"score\":%d,\"serial\":%d,\"message\":\"%s\"}",player.Room,player.x,player.y,player.InventoryQuantity[1],questDone,talkStage,typedMode,game.score,saveSerial,message));
    f.Close();
  }
}
function Say(String text) {
  message=text;
  if(caption!=null)caption.Remove();
  caption=Overlay.CreateTextual(4,25,310,0,65535,text);
  Report();
}
function Arrive() {
  if(player.Room==1){object[0].Visible=!herbTaken;Say("The courtyard. A herb grows beside the path.");}
  else if(player.Room==2) {
    if(questDone)Say("Mira: Thank you again. The garden is open.");
    else Say("Mira: Welcome. I need a healing herb.");
  }
  else Say("A new garden, added through the room authoring tool.");
}
function Door() {
  player.Walk(285,175,eBlock,eWalkableAreas);
  if(player.Room==1)player.ChangeRoom(2,285,190);
  else if(player.Room==2)player.ChangeRoom(1,285,190);
  else player.ChangeRoom(1,30,215);
}
function TakeHerb() {
  if(player.Room!=1) {Say("There is no herb here.");return;}
  if(herbTaken) {Say("You already picked the herb.");return;}
  player.Walk(84,180,eBlock,eWalkableAreas);
  player.AddInventory(iHerb);herbTaken=true;object[0].Visible=false;
  Say("You pick the healing herb. It is in your inventory.");
}
function Talk() {
  if(player.Room!=2){Say("There is nobody here to answer.");return;}
  talkStage=1;
  Say("Mira: Ask me about the herb, or offer the herb if you have it.");
}
function GiveHerb() {
  if(player.Room!=2){Say("The healer is not here.");return;}
  if(questDone){Say("Mira has already rewarded you.");return;}
  if(player.InventoryQuantity[1]==0){Say("You have no herb to offer.");return;}
  player.Walk(183,164,eBlock,eWalkableAreas);
  player.LoseInventory(iHerb);questDone=true;GiveScore(5);talkStage=0;
  Say("Mira: Thank you! Five points. The garden is now open.");
}
function Command(String text) {
  // Browser controls carry input intents, never quest flags or arbitrary state.
  if(text=="@1"){mouse.Mode=eModeWalkto;return;}
  if(text=="@2"){mouse.Mode=eModeLookat;return;}
  if(text=="@3"){mouse.Mode=eModeTalkto;return;}
  if(text=="@4"){mouse.Mode=eModeInteract;return;}
  if(text=="@t"){typedMode=!typedMode;if(typedMode)Say("Typed mode. Enter a command below.");else Say("Point and click mode.");return;}
  if(text=="@s"){saveSerial++;SaveGameSlot(1,"Quest Lab proof");Say("Save requested. Wait for browser confirmation.");return;}
  if(text=="@l"){RestoreGameSlot(1);return;}
  if(text=="@i"){if(player.InventoryQuantity[1]>0)Say("Inventory: healing herb");else Say("Inventory: empty");return;}
  Parser.ParseText(text);
  if(Parser.SaidUnknownWord()!=null) {Say("I do not know that word. Try another description.");return;}
  if(Parser.Said("look"))Arrive();
  else if(Parser.Said("take herb"))TakeHerb();
  else if(Parser.Said("enter door"))Door();
  else if(Parser.Said("leave"))Door();
  else if(Parser.Said("talk healer"))Talk();
  else if(Parser.Said("give herb healer") || Parser.Said("give herb"))GiveHerb();
  else if(Parser.Said("look herb") || Parser.Said("talk healer about herb"))Say("A bright green healing herb. Mira needs one.");
  else if(Parser.Said("inventory")) {
    if(player.InventoryQuantity[1]>0)Say("You are carrying a healing herb.");else Say("Your inventory is empty.");
  }
  else if(Parser.Said("look stone") && player.Room==3)Say("A sunstone: a new interactable object added by prompt.");
  else if(Parser.Said("enter garden")) {
    if(questDone)player.ChangeRoom(3,70,215);else Say("The garden is locked until Mira has her herb.");
  }
  else Say("Those words do not describe an action here.");
}
function game_start() {
  SetMultitaskingMode(1);SetGameSpeed(40);mouse.Mode=eModeWalkto;message="Ready";Arrive();
}
function repeatedly_execute() {
  clockTicks++;
  // Text input is provided by a normal HTML form. AGS owns parsing and consequences.
  if(clockTicks%5==0) {
    File* f=File.Open("$APPDATADIR$/proof-input.txt",eFileRead);
    if(f!=null){String text=f.ReadRawLineBack();f.Close();File.Delete("$APPDATADIR$/proof-input.txt");Command(text);}
  }
  if(clockTicks%20==0)Report();
}
function on_key_press(eKeyCode key, int mod) {
  if(key==eKey1)mouse.Mode=eModeWalkto;
  else if(key==eKey2)mouse.Mode=eModeLookat;
  else if(key==eKey3)mouse.Mode=eModeTalkto;
  else if(key==eKey4)mouse.Mode=eModeInteract;
  else if(key==eKeyT){typedMode=!typedMode;if(typedMode)Say("Typed mode. Enter a command below.");else Say("Point and click mode.");}
  else if(key==eKeyS){saveSerial++;SaveGameSlot(1,"Quest Lab proof");Say("Save requested. Wait for browser confirmation.");}
  else if(key==eKeyL)RestoreGameSlot(1);
  else if(key==eKeyI){if(player.InventoryQuantity[1]>0)Say("Inventory: healing herb");else Say("Inventory: empty");}
}
function on_mouse_click(MouseButton button) {
  if(button!=eMouseLeft || typedMode || IsGamePaused())return;
  Hotspot* h=Hotspot.GetAtScreenXY(mouse.x,mouse.y);
  if(h.ID==1){if(mouse.Mode==eModeLookat)Say("An open doorway.");else Door();}
  else if(h.ID==2 && player.Room==1){if(mouse.Mode==eModeLookat)Say("A healing herb beside the path.");else TakeHerb();}
  else if(h.ID==2 && player.Room==2){if(mouse.Mode==eModeTalkto)Talk();else if(mouse.Mode==eModeInteract)GiveHerb();else Say("Mira waits behind her table.");}
  else if(h.ID==2 && player.Room==3)Say("A sunstone: a new interactable object added by prompt.");
  else if(player.Room==1 && mouse.x<45 && mouse.y>190 && questDone)player.ChangeRoom(3,70,215);
  else Room.ProcessClick(mouse.x,mouse.y,eModeWalkto);
}
